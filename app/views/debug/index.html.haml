= stylesheet_link_tag 'debug'

%dl.debug

  - if Rails.env.production?
    %dt Git revision
    %dd
      :ruby
        git_revision = false
        revision_file = File.join(Rails.root, 'REVISION')
        if File.exist?(revision_file)
          git_revision = File.read(revision_file)
        end
        deploy_time = false
        revision_time = File.join(Rails.root, 'REVISION_TIME')
        if File.exist?(revision_time)
          revision_timestamp = File.read(revision_time)
          deploy_time = Time.at revision_timestamp.strip.to_i
        end
      .truncate
        = git_revision ? link_to(git_revision, "https://github.com/tekniklr/tekniklr.com/commit/#{git_revision}", target: '_blank') : 'unknown'
      - if deploy_time
        deployed at #{deploy_time.to_fs(:precise)}

  %dt Ruby version
  %dd
    #{RUBY_VERSION}-p#{defined?(RbConfig) ? RbConfig::CONFIG['PATCHLEVEL'] : Config::CONFIG['PATCHLEVEL']}

  %dt Rails version
  %dd
    = Rails.version

  %dt Gems
  %dd
    - if Rails.configuration.respond_to?(:gems)
      - Rails.configuration.gems.sort{|a,b| a.specification.name <=> b.specification.name}.each do |g|
        .row.mb-1
          .col
            .truncate
              #{g.specification.name} - #{g.specification.version}"}
    - else
      - Gem.loaded_specs.values.sort{|a,b| a.name <=> b.name}.collect{|s| [s.name, s.version, s.homepage]}.each do |name, version, url|
        .row.mb-1
          .col-lg-4.col-md-5.col-8
            .truncate
              - unless url.blank?
                = link_to name, url, target: '_blank'
              - else
                = name
          .col-lg-2.col-md-3.col-4
            .truncate
              = version